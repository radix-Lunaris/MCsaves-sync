# ==========================================================================
#  MCSync 忽略规则
#  原则：只提交源码与文档；一切「构建产物 / 运行环境 / 运行时数据 / 含密钥
#        的文件」都不进仓库。
# ==========================================================================

# ------------------------------------------------------------------ Python
__pycache__/
*.py[cod]
*.so
*.pyd
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.installed.cfg

# ------------------------------------------------- 虚拟环境与依赖目录
.venv/
venv/
env/
ENV/
.buildenv/

# ------------------------------------------------------------ 打包产物
# PyInstaller 生成的 exe 与中间目录（体积大、可随时重建）
*.exe
*.msi
*.spec
release/
installer/
downloads/

# ------------------------------------------------------------ 测试与缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
tmp/
temp/

# ------------------------------------------------- 运行时数据（含用户存档）
# 服务端真实数据：别人的存档、版本清单、数据块，绝对不能提交
data/
serverdata/
blobs/
manifests/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------ 凭证与密钥
# 服务端部署会生成 16 位口令与客户端私钥，泄露等于服务器被接管
mcsync.env
*.env
!.env.example
# 账号库：含口令哈希与盐，绝不能进仓库
accounts.json
.env.local
clients.json
token.txt
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# ------------------------------------------------------- 客户端本地配置
# 配置已改存系统目录（%LOCALAPPDATA%\MCSync），这里防的是旧版本残留
config.json
*.cfg.local

# ------------------------------------------------------------ 编辑器与系统
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------ 备份与临时
# 同步时生成的本地备份目录（内含完整存档副本，体积巨大）
_MCSyncBackups/
.mcsync-cache/
*.bak
*.tmp
*.part
