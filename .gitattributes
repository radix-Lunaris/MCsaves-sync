# ==========================================================================
#  MCSync Git 属性
#  统一行尾，避免 Windows / Linux 交叉开发时整个文件被判为改动。
# ==========================================================================

# 自动归一化：提交时统一为 LF
* text=auto eol=lf

# Windows 批处理 / 命令脚本必须是 CRLF，否则 cmd 解析会出各种怪问题
# （历史上出现过中文被按字节截断导致 "was unexpected at this time"）
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Shell 脚本必须是 LF，带上 CRLF 在 Linux 上会报 bad interpreter
*.sh    text eol=lf

# 二进制文件，不做任何转换
*.png   binary
*.ico   binary
*.jpg   binary
*.zip   binary
*.exe   binary
*.db    binary

# 许可证与文档不参与 diff 折叠
LICENSE          -diff
*.min.js         -diff
